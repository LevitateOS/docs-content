{
	"name": "@levitate/docs-content",
	"version": "0.1.0",
	"license": "(MIT OR Apache-2.0)",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./types": "./src/types.ts",
		"./distros": "./src/distros.ts",
		"./install": "./src/install.ts",
		"./syntax-theme": "./src/syntax-theme.ts",
		"./pages": "./src/pages.ts"
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"generated:check": "bun scripts/build.ts --check-generated",
		"typecheck": "tsc --noEmit",
		"lint": "bunx oxlint --config ../../.oxlintrc.json src scripts --deny-warnings",
		"lint:fix": "bunx oxlint --config ../../.oxlintrc.json src scripts --fix",
		"format": "bunx oxfmt --config ../../.oxfmtrc.json --write src scripts package.json tsconfig.json",
		"format:check": "bunx oxfmt --config ../../.oxfmtrc.json --check src scripts package.json tsconfig.json",
		"check": "bun run generated:check && bun run typecheck && bun run lint && bun run format:check"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"oxlint": "1.39.0",
		"shiki": "^3.22.0",
		"typescript": "^5.7.2"
	},
	"packageManager": "bun@1.4.2"
}
